# .env.example – скопируйте в .env и заполните своими значениями

# База данных
DATABASE_URL=sqlite:///dnsight.db
# для PostgreSQL можно: postgresql://user:password@localhost/dnsight

# Настройки парсинга
REQUEST_TIMEOUT=60
MAX_RETRIES=5
RETRY_DELAY=5

# URL категорий DNS (можно переопределить, если нужно)
DNS_CPU_URL=https://www.dns-shop.ru/catalog/17a899cd16404e77/processory/
DNS_GPU_URL=https://www.dns-shop.ru/catalog/17a89aab16404e77/videokarty/
DNS_MOTHERBOARD_URL=https://www.dns-shop.ru/catalog/17a89a0416404e77/materinskie-platy/
DNS_RAM_DIMM_URL=https://www.dns-shop.ru/catalog/17a89a3916404e77/operativnaa-pamat-dimm/
DNS_RAM_SODIMM_URL=https://www.dns-shop.ru/catalog/17a9b91b16404e77/operativnaa-pamat-so-dimm/
DNS_PSU_URL=https://www.dns-shop.ru/catalog/17a89c2216404e77/bloki-pitania/
DNS_CASE_URL=https://www.dns-shop.ru/catalog/17a89c5616404e77/korpusa/
DNS_COOLER_URL=https://www.dns-shop.ru/catalog/17a9cc2d16404e77/kulery-dla-processorov/
DNS_LCS_URL=https://www.dns-shop.ru/catalog/17a9cc9816404e77/sistemy-zidkostnogo-ohlazdenia/
DNS_SSD_URL=https://www.dns-shop.ru/catalog/8a9ddfba20724e77/ssd-nakopiteli/
DNS_SSDM2_URL=https://www.dns-shop.ru/catalog/dd58148920724e77/ssd-m2-nakopiteli/
DNS_HDD35_URL=https://www.dns-shop.ru/catalog/17a8914916404e77/zestkie-diski-35/
DNS_HDD25_URL=https://www.dns-shop.ru/catalog/f09d15560cdd4e77/zestkie-diski-25/

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Кэширование (в секундах)
CACHE_TTL=3600

# Коэффициенты (можно переопределить)
GPU_TARGET_MULTIPLIER=1.25
TDP_PHASE_RATIO=10.58
INF_REPLACEMENT=0.0

# Коэффициенты для RAM
RAM_ECC_NO=1.0
RAM_ECC_YES=1.5
RAM_HEATSINK_NO=0.5
RAM_HEATSINK_YES=1.0

# Коэффициенты для расчёта скора PSU
PSU_CERT_80PLUS_NO=1.0
PSU_CERT_80PLUS_STANDARD=1.5
PSU_CERT_80PLUS_BRONZE=2.0
PSU_CERT_80PLUS_SILVER=2.5
PSU_CERT_80PLUS_GOLD=3.0
PSU_CERT_80PLUS_PLATINUM=3.5
PSU_CERT_80PLUS_TITANIUM=4.0

PSU_CABLES_NO=1.0
PSU_CABLES_SEMI=1.5
PSU_CABLES_FULL=2.0

PSU_SLEEVING_NO=0.5
PSU_SLEEVING_YES=1.0
PSU_SLEEVING_PROTECTIVE=1.5
PSU_SLEEVING_INDIVIDUAL=2.0